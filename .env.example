# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://jouw-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_jouw_publieke_key

# Lokaal meestal http://localhost:5173/. Op Vercel jouw definitieve app-URL.
# Laat leeg om automatisch de huidige URL te gebruiken.
VITE_APP_URL=

# Alleen server-side in Vercel gebruiken — NOOIT met VITE_ prefix.
# Nodig voor website-intake API en mailboxkoppelingen:
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64 of 64 hex tekens. Versleutelt refresh tokens server-side.
OPTERO_MAILBOX_TOKEN_KEY=
# Lange willekeurige tekst voor ondertekende OAuth-state (minimaal 24 tekens).
OPTERO_OAUTH_STATE_SECRET=

# Microsoft Entra app registration (delegated Mail.Read + User.Read + offline_access)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Google Cloud OAuth web client met Gmail API ingeschakeld
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
